#
# Started from the X session (see raspdash.desktop).  Keeps the screen
# awake, then runs raspdash inside a full-screen alacritty and restarts
# it whenever it exits or crashes, and every 3 hours.
#
# Environment:
#   RASPDASH          raspdash binary          (default: next to this
#                                              script, then PATH)
#   RASPDASH_CONFIG   configuration file       (default: raspdash's search)
#   RASPDASH_TERM_CONFIG  alacritty config     (default: next to this script,
#                         then $datadir/raspdash/alacritty-kiosk.toml)
#   RASPDASH_KEEP_SCREENSAVER=1  leave xscreensaver and DPMS alone
#   RASPDASH_RESTART  restart raspdash after this long, as timeout(1)
#                     takes it (default: 3h; 0 never restarts)

set -u

here=$(cd "$(dirname "$0")" && pwd)
# The launcher is installed next to raspdash; the login session's PATH
# may not include ~/.local/bin.
if [ -n "${RASPDASH:-}" ]; then
    bin=$RASPDASH
elif [ -x "$here/raspdash" ]; then
    bin=$here/raspdash
else
    bin=raspdash
fi
term_config=${RASPDASH_TERM_CONFIG:-}
if [ -z "$term_config" ]; then
    for c in "$here/alacritty-kiosk.toml" \
             "$here/../share/raspdash/alacritty-kiosk.toml"; do
        [ -r "$c" ] && { term_config=$c; break; }
    done
fi

log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/raspdash
mkdir -p "$log_dir"
log=$log_dir/kiosk.log

if [ "${RASPDASH_KEEP_SCREENSAVER:-0}" != 1 ]; then
    xset s off -dpms s noblank 2>/dev/null
    command -v xscreensaver-command >/dev/null 2>&1 \
        && xscreensaver-command -exit >/dev/null 2>&1
fi

# The autostart entry runs alongside the window manager.  A window mapped
# before the window manager runs loses its fullscreen request and stays
# 800x600, so wait (up to 30 seconds) for an EWMH window manager.
if command -v xprop >/dev/null 2>&1; then
    tries=0
    until xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null \
            | grep -q 'window id'; do
        tries=$((tries + 1))
        [ "$tries" -ge 30 ] && break
        sleep 1
    done
    sleep 1
fi

# Hide the mouse pointer when unclutter is installed.
command -v unclutter >/dev/null 2>&1 && { unclutter -idle 1 & }

export LANG=${LANG:-C.UTF-8}

# Restart raspdash every few hours, so a hung or slowly failing instance
# does not stay on screen.  raspdash quits on SIGTERM; a hung one is
# killed two minutes later.
restart=${RASPDASH_RESTART:-3h}

while :; do
    echo "$(date -Is) starting $bin" >>"$log"
    if [ -n "$term_config" ]; then
        alacritty --config-file "$term_config" --class raspdash \
            -e timeout --foreground -k 2m "$restart" "$bin" 2>>"$log"
    else
        alacritty -o window.startup_mode=Fullscreen \
            -e timeout --foreground -k 2m "$restart" "$bin" 2>>"$log"
    fi
    echo "$(date -Is) exited with status $?" >>"$log"
    sleep 3
done
